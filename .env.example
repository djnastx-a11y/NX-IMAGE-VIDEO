# ---------------------------------------------------------------- NX STUDIO
# Copy to .env and fill in. Never commit .env. Secrets stay on the server: the web app never sees them.

# --- docker compose only
POSTGRES_PASSWORD=change-me-long-random
NX_PORT=8787

# --- server
NODE_ENV=production
# all = API + web + worker in one process; api / worker to split them (see docs/ARCHITECTURE.md)
NX_ROLE=all
# DATABASE_URL=postgres://nx:password@127.0.0.1:5432/nxstudio   (set by docker compose)
PORT=8787
# Behind a reverse proxy / HTTPS (Caddy, Nginx, Cloudflare): keep both true
TRUST_PROXY=true
COOKIE_SECURE=true
SESSION_TTL_DAYS=30

# --- first admin (optional: otherwise the first visit shows a "create admin" screen)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Admin

# --- media storage: local (default, under NX_DATA_DIR/media) or s3 (AWS S3, Cloudflare R2, MinIO...)
STORAGE_DRIVER=local
# NX_DATA_DIR=/data
# S3_BUCKET=nx-studio
# S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_PREFIX=

# --- job worker
NX_WORKER_CONCURRENCY=2
NX_LEASE_SECONDS=60
NX_WORKER_POLL_MS=1000

# --- engines
# Test engines (real files, no GPU). Turn off once real engines are connected.
NX_ENABLE_MOCK=true
NX_MOCK_MIN_SECONDS=4
# GPU endpoints speaking the NX GPU protocol (docs/GPU_WORKERS.md). JSON array; the token itself goes in its own variable.
# NX_GPU_ENDPOINTS=[{"id":"runpod-1","url":"https://xxxx-8188.proxy.runpod.net","tokenEnv":"NX_GPU_TOKEN_RUNPOD1"}]
# NX_GPU_TOKEN_RUNPOD1=

# --- security
RATE_LIMIT_MAX=600
RATE_LIMIT_LOGIN_MAX=10
